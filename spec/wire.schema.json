{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMP Core HTTP RPC envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "request",
        "result",
        "error"
      ]
    },
    "method": {
      "type": "string"
    },
    "params": {
      "type": "object"
    },
    "result": {},
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}
